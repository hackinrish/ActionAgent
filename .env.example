# Required — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Team members (comma-separated full names)
TEAM_MEMBERS=Alice Smith,Bob Jones,Carol White

# Local SQLite database path (default: local.db in project root)
LOCAL_DB_PATH=local.db

# Max retries for validation before forcing through flagged items
MAX_VALIDATION_ATTEMPTS=3
